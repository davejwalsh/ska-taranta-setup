########################################################################
# GRAFANA FOR THE HDB++ ARCHIVE
#
# Generated by ska-taranta-setup (`ska-taranta init`). Safe to edit; `init`
# won't overwrite it unless run with --force. Grafana is off until you run
# `make grafana`, which only works when HDB++ is deployed.
########################################################################

TARANTA_RUN ?= {run_prefix}
GRAFANA_PORT ?= 3000
GRAFANA_ARGS = $(if $(KUBE_NAMESPACE),--namespace $(KUBE_NAMESPACE)) --port $(GRAFANA_PORT)

grafana: ## if HDB++ is deployed: scan the archive and open Grafana with its dashboard on localhost:$(GRAFANA_PORT)
	$(TARANTA_RUN) ska-taranta grafana $(GRAFANA_ARGS)

grafana-off: ## stop Grafana again
	$(TARANTA_RUN) ska-taranta grafana --off $(GRAFANA_ARGS)

archiver-dashboard: ## only regenerate the archive dashboard (no deploy)
	$(TARANTA_RUN) ska-taranta archiver-dashboard $(if $(KUBE_NAMESPACE),--namespace $(KUBE_NAMESPACE))

.PHONY: grafana grafana-off archiver-dashboard
