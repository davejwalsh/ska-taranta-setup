########################################################################
# HDB++ ARCHIVE DASHBOARD (Grafana)
#
# Generated by ska-taranta-setup (`ska-taranta init --archiver`). Safe to
# edit; `init` won't overwrite it unless run with --force.
########################################################################

TARANTA_RUN ?= {run_prefix}
GRAFANA_PORT ?= 3000

archiver-dashboard: ## scan the HDB++ archive and regenerate its Grafana dashboard
	$(TARANTA_RUN) ska-taranta archiver-dashboard

grafana-port: ## forward Grafana to localhost:$(GRAFANA_PORT) (browse anonymously, or log in as admin)
	kubectl port-forward -n $(KUBE_NAMESPACE) \
		$$(kubectl get svc -n $(KUBE_NAMESPACE) -l app.kubernetes.io/name=grafana -o name | head -1) \
		$(GRAFANA_PORT):80

.PHONY: archiver-dashboard grafana-port
